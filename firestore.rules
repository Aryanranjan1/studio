/**
 * Core Philosophy: This ruleset enforces a strict public read-only model.
 * All data within the `portfolio_projects` and `cms_content` collections
 * is considered public and can be read by any client, authenticated or not.
 * To protect data integrity, all write operations (create, update, delete)
 * from the client-side are explicitly disabled. It is assumed that data
 * modifications are handled exclusively by a trusted backend server environment
 * using the Firebase Admin SDK.
 *
 * Data Structure: The data is organized into two independent, top-level
 * collections: `/portfolio_projects` and `/cms_content`. There are no user-
 * specific subcollections or hierarchical relationships that would require
 * complex authorization checks.
 *
 * Key Security Decisions:
 * - Public Read Access: All documents are publicly readable to support the
 *   website's portfolio showcase functionality without requiring user login.
 * - Client-Side Writes Disabled: All write operations are denied as a security
 *   precaution. This prevents unauthorized modification of public-facing content.
 * - No Ownership Model: Since the data is for public display and managed
 *   externally (likely via a CMS), there is no concept of document ownership
 *   within the security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public, read-only access to all portfolio projects.
     * @path /portfolio_projects/{projectId}
     * @allow Anyone, signed-in or not, can read a project. (e.g., `(get) /portfolio_projects/some_project_id`)
     * @deny No one can create a new project from the client. (e.g., `(create) /portfolio_projects/new_project` is denied)
     * @principle Data is public read-only. Writes must be performed by a trusted backend service using the Admin SDK.
     */
    match /portfolio_projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public, read-only access to all CMS content.
     * @path /cms_content/{contentId}
     * @allow Anyone can list all CMS content. (e.g., `(list) /cms_content`)
     * @deny No one can update existing CMS content from the client. (e.g., `(update) /cms_content/some_id` is denied)
     * @principle Data is public read-only. Writes must be performed by a trusted backend service using the Admin SDK.
     */
    match /cms_content/{contentId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}