
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ========= HELPERS ========= */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin_profiles/$(request.auth.uid));
    }

    /* ========= PROJECTS (formerly portfolio_projects) ========= */
    match /projects/{projectId} {
      // Public can read published projects. Admins can read any.
      allow get: if resource.data.status == 'published' || isAdmin();
      
      // List is open for server-side sitemap generation. The query filters by status.
      allow list: if true;
      
      // Only admins can write.
      allow create, update, delete: if isAdmin();
    }

    /* ========= BLOGS ========= */
    match /blogs/{blogId} {
      // Public can read published posts. Admins can read any.
      allow get: if resource.data.status == 'published' || isAdmin();
      
      // List is open for server-side sitemap generation. The query filters by status.
      allow list: if true;
      
      // Only admins can write.
      allow create, update, delete: if isAdmin();
    }
    
    /* ========= FAQS ========= */
    match /faqs/{faqId} {
      // Public can read published FAQs, Admins can read any.
      allow get: if resource.data.published == true || isAdmin();
      
      // List is open for server-side sitemap generation. The query filters by status.
      allow list: if true;
      
      // Admins can write.
      allow create, update, delete: if isAdmin();
    }

    /* ========= TEMPLATES ========= */
    match /templates/{templateId} {
      // Public can read published templates, Admins can read any.
      allow get: if resource.data.status == 'published' || isAdmin();
      
      // List is open for server-side sitemap generation. The query filters by published status.
      allow list: if true;
      
      // Only admins can write.
      allow create, update, delete: if isAdmin();
    }
    
    /* ========= MESSAGES ========= */
    match /messages/{messageId} {
      allow create: if true; // Allow public contact form submissions
      allow read, update, delete: if isAdmin(); // Admins have full control
      allow list: if isAdmin(); // Only admins can list all messages
    }
    
    /* ========= SETTINGS ========= */
    match /site_settings/{docId} {
       allow get: if true; // Publicly readable to check feature flags
       allow list: if isAdmin();
       allow write: if isAdmin(); // Only admins can change settings
    }

    /* ========= TESTIMONIALS ========= */
    match /testimonials/{testimonialId} {
        allow get, list: if true; // Publicly readable
        allow create, update, delete: if isAdmin(); // Admins have full control
    }

    /* ========= USERS ========= */
    match /users/{userId} {
      allow get, create, update, delete: if
        isSignedIn() && request.auth.uid == userId;
      allow list: if false;
    }

    /* ========= ADMIN PROFILES ========= */
    match /admin_profiles/{adminId} {
      allow get: if
        isAdmin()
        || (isSignedIn() && request.auth.uid == adminId);

      allow list, create, update, delete: if isAdmin();
    }
  }
}
