
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ========= HELPERS ========= */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin_profiles/$(request.auth.uid));
    }

    /* ========= PROJECTS ========= */

    match /projects/{projectId} {

      /*
       * SINGLE DOC READ
       * - Public: only published
       * - Admin: everything
       */
      allow get: if
        resource.data.published == true
        || isAdmin();

      /*
       * COLLECTION QUERIES (LIST)
       *
       * ✅ Admin: unrestricted
       * ✅ Public (auth null allowed):
       *    MUST filter published == true
       *
       * This rule PREVENTS:
       * - collection(db, "projects")
       * - admin-only reads in global scope
       */
      allow list: if
        isAdmin()
        ||
        (
          request.auth == null
          && request.query.where('published', '==', true)
        )
        ||
        (
          isSignedIn()
          && request.query.where('published', '==', true)
        );

      /*
       * WRITES
       */
      allow create, update, delete: if isAdmin();
    }

    /* ========= BLOGS ========= */

    match /blogs/{blogId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    /* ========= FAQS ========= */

    match /faqs/{faqId} {
      // Public can read published FAQs, Admins can read any.
      allow get: if resource.data.published == true || isAdmin();
      
      // Public can query for published FAQs, Admins can query for any.
      allow list: if request.query.where('published', '==', true) || isAdmin();
      
      // Admins can write.
      allow create, update, delete: if isAdmin();
    }

    /* ========= TEMPLATES ========= */

    match /templates/{templateId} {
      allow get: if resource.data.published == true || isAdmin();
      allow list: if request.query.where('published', '==', true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /* ========= USERS ========= */

    match /users/{userId} {
      allow get, create, update, delete: if
        isSignedIn() && request.auth.uid == userId;
      allow list: if false;
    }

    /* ========= ADMIN PROFILES ========= */

    match /admin_profiles/{adminId} {
      allow get: if
        isAdmin()
        || (isSignedIn() && request.auth.uid == adminId);

      allow list, create, update, delete: if isAdmin();
    }
  }
}

    

    