rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Services ---
    // Anyone can read the list of services.
    // Only authenticated admins should be able to write/update services.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null; // Placeholder: restrict to admin later
    }

    // --- Projects ---
    // Anyone can read the list of projects.
    // Only authenticated admins should be able to write/update projects.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null; // Placeholder: restrict to admin later
    }

    // --- Testimonials ---
    // Anyone can read testimonials.
    // Only authenticated admins should be able to add testimonials.
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if request.auth != null; // Placeholder: restrict to admin later
    }

    // --- FAQ ---
    // Anyone can read FAQ items.
    // Only authenticated admins should be able to manage FAQs.
    match /faq/{faqId} {
      allow read: if true;
      allow write: if request.auth != null; // Placeholder: restrict to admin later
    }

    // --- Articles ---
    // Anyone can read articles.
    // Only authenticated admins should be able to manage articles.
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null; // Placeholder: restrict to admin later
    }
    
    // --- Templates ---
    // Anyone can read templates.
    // Only authenticated admins should be able to manage templates.
    match /templates/{templateId} {
        allow read: if true;
        allow write: if request.auth != null; // Placeholder: restrict to admin later
    }

    // --- User Profiles ---
    // Users can create their own profile.
    // Users can read their own profile.
    // Users can update their own profile.
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
      // Disallow public reading of other user profiles for now
      allow read: if false; 
    }
  }
}
