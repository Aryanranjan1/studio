
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the AMpire Studio platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile photo.",
          "format": "uri"
        },
        "creationTime": {
          "type": "string",
          "description": "Timestamp indicating when the user was created.",
          "format": "date-time"
        },
        "lastSignInTime": {
          "type": "string",
          "description": "Timestamp indicating when the user last signed in.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email"
      ]
    },
    "AdminProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminProfile",
      "type": "object",
      "description": "Represents the profile of an administrator user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the admin profile."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:1 AdminProfile)"
        },
        "role": {
          "type": "string",
          "description": "The role of the administrator (e.g., superAdmin, editor)."
        },
        "permissions": {
          "type": "array",
          "description": "List of permissions granted to the administrator.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "userId",
        "role"
      ]
    },
    "Message": {
      "title": "Message",
      "description": "Represents a message or form submission from a user.",
      "type": "object",
      "properties": {
        "senderName": { "type": "string" },
        "senderEmail": {
          "type": "string",
          "description": "The sender's email address.",
          "format": "email"
        },
        "senderPhone": {
            "type": "string",
            "description": "The sender's phone number."
        },
        "senderCompany": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read", "replied", "archived"] },
        "source": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "isArchived": { "type": "boolean" },
        "replies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repliedBy": { "type": "string" },
              "body": { "type": "string" },
              "sentAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "required": ["senderName", "subject", "body", "status", "receivedAt"]
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global settings for site functionality, like email and AI.",
      "type": "object",
      "properties": {
        "emailConfig": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "senderName": { "type": "string" },
            "senderEmail": { "type": "string", "format": "email" }
          }
        },
        "aiConfig": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { "type": "string", "enum": ["gemini", "openai"] }
          }
        }
      }
    },
    "BlogArticle": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Blog Article",
      "type": "object",
      "description": "Represents a single blog article with comprehensive metadata for content and SEO.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the blog article."
        },
        "title": {
          "type": "string",
          "description": "The main title of the article."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the article."
        },
        "category": {
          "type": "string",
          "description": "The primary category of the article."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "An array of tags associated with the article."
        },
        "author": {
          "type": "string",
          "description": "Name of the article's author."
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published"
          ],
          "description": "The publishing status of the article."
        },
        "publishDate": {
          "type": "string",
          "format": "date-time",
          "description": "The date when the article is published."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "The date when the article was last updated."
        },
        "content": {
          "type": "string",
          "description": "The full content of the article in raw HTML format."
        },
        "metaTitle": {
          "type": "string",
          "description": "Custom title for SEO purposes (60 characters recommended)."
        },
        "metaDescription": {
          "type": "string",
          "description": "Custom description for SEO purposes (160 characters recommended)."
        },
        "focusKeyword": {
          "type": "string",
          "description": "The primary keyword the article is targeting for SEO."
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "description": "The canonical URL for the article to prevent duplicate content issues."
        },
        "robotsMeta": {
          "type": "string",
          "enum": [
            "index",
            "noindex"
          ],
          "description": "Robots meta tag to control search engine indexing."
        },
        "featuredImage": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "alt"
          ]
        },
        "cardImage": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "alt"
          ]
        },
        "ogImage": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "alt"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "slug",
        "author",
        "status",
        "publishDate",
        "content",
        "metaTitle",
        "metaDescription"
      ]
    },
    "PortfolioProject": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Portfolio Project",
      "type": "object",
      "description": "Represents a single portfolio project with detailed information for display and SEO.",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the project."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly slug for the project."
        },
        "summary": {
          "type": "string",
          "description": "A short summary for listings and previews."
        },
        "category": {
          "type": "string",
          "description": "The primary category or service type of the project."
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of technologies used in the project."
        },
        "clientName": {
          "type": "string",
          "description": "The name of the client, if applicable."
        },
        "projectYear": {
          "type": "string",
          "description": "The year the project was completed."
        },
        "projectUrl": {
          "type": "string",
          "format": "uri",
          "description": "The live URL of the project."
        },
        "longDescription": {
          "type": "string",
          "description": "A detailed description of the project in HTML format."
        },
        "featuredImage": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "alt": { "type": "string" }
          },
          "required": ["url", "alt"]
        },
        "cardImage": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "alt": { "type": "string" }
          },
          "required": ["url", "alt"]
        },
        "galleryImages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "alt": { "type": "string" }
            },
            "required": ["url", "alt"]
          }
        },
        "published": {
          "type": "boolean",
          "description": "The publishing status of the project."
        },
        "publishDate": {
          "type": "string",
          "format": "date-time"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        },
        "metaTitle": { "type": "string" },
        "metaDescription": { "type": "string" },
        "focusKeyword": { "type": "string" },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "robotsMeta": { "type": "string", "enum": ["index", "noindex"] }
      },
      "required": [
        "title",
        "slug",
        "summary",
        "category",
        "technologies",
        "projectYear",
        "longDescription",
        "featuredImage",
        "cardImage",
        "published",
        "publishDate",
        "metaTitle",
        "metaDescription"
      ]
    },
    "FaqItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FAQ Item",
      "type": "object",
      "description": "Represents a single Frequently Asked Question item.",
      "properties": {
        "question": {
          "type": "string",
          "description": "The question text."
        },
        "answer": {
          "type": "string",
          "description": "The answer text, which can include basic HTML."
        },
        "preview": {
          "type": "string",
          "description": "A short preview of the answer for list views."
        },
        "category": {
          "type": "string",
          "description": "The category the FAQ belongs to (e.g., General, Pricing)."
        },
        "order": {
            "type": "number",
            "description": "A number to determine the display order."
        },
        "published": {
          "type": "boolean",
          "description": "The publishing status of the FAQ."
        },
        "link": {
          "type": "object",
          "properties": {
            "href": { "type": "string", "format": "uri" },
            "text": { "type": "string" }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the FAQ was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the FAQ was last updated."
        }
      },
      "required": [
        "question",
        "answer",
        "preview",
        "category",
        "order",
        "published"
      ]
    },
    "Template": {
      "title": "Template",
      "description": "Represents a website template available for purchase or use.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "shortDescription": { "type": "string" },
        "longDescription": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "technologies": { "type": "array", "items": { "type": "string" } },
        "specs": {
          "type": "object",
          "properties": {
            "stack": { "type": "string" },
            "css": { "type": "string" },
            "cms": { "type": "string" },
            "type": { "type": "string" }
          }
        },
        "features": { "type": "array", "items": { "type": "string" } },
        "previewUrl": { "type": "string", "format": "uri" },
        "cardImage": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "alt": { "type": "string" }
          },
          "required": ["url", "alt"]
        },
        "galleryImages": {
          "type": "array",
          "items": {
             "type": "object",
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "alt": { "type": "string" }
              },
              "required": ["url", "alt"]
          }
        },
        "bestSeller": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "version": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "metaTitle": { "type": "string" },
        "metaDescription": { "type": "string" }
      },
      "required": ["title", "slug", "shortDescription", "price", "published"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles. Uses path-based ownership for private user data.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user, matching the Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/admin_profiles/{adminProfileId}",
        "definition": {
          "entityName": "AdminProfile",
          "schema": {
            "$ref": "#/backend/entities/AdminProfile"
          },
          "description": "Stores admin profiles. Includes a userId to reference the associated user. The existence of a document in this collection grants admin privileges.",
          "params": [
            {
              "name": "adminProfileId",
              "description": "The unique identifier of the admin profile."
            }
          ]
        }
      },
      {
        "path": "/blogs/{blogId}",
        "definition": {
          "entityName": "BlogArticle",
          "schema": {
            "$ref": "#/backend/entities/BlogArticle"
          },
          "description": "Stores all blog articles for the CMS.",
          "params": [
            {
              "name": "blogId",
              "description": "The unique identifier for the blog post."
            }
          ]
        }
      },
       {
        "path": "/projects/{projectId}",
        "definition": {
          "entityName": "PortfolioProject",
          "schema": {
            "$ref": "#/backend/entities/PortfolioProject"
          },
          "description": "Stores all portfolio projects for the CMS.",
          "params": [
            {
              "name": "projectId",
              "description": "The unique identifier for the portfolio project."
            }
          ]
        }
      },
      {
        "path": "/faqs/{faqId}",
        "definition": {
          "entityName": "FaqItem",
          "schema": {
            "$ref": "#/backend/entities/FaqItem"
          },
          "description": "Stores all FAQ items for the application.",
          "params": [
            {
              "name": "faqId",
              "description": "The unique identifier for the FAQ item."
            }
          ]
        }
      },
      {
        "path": "/templates/{templateId}",
        "definition": {
          "entityName": "Template",
          "schema": {
            "$ref": "#/backend/entities/Template"
          },
          "description": "Stores all website templates for the store.",
          "params": [
            {
              "name": "templateId",
              "description": "The unique identifier for the template."
            }
          ]
        }
      },
      {
        "path": "/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "schema": {
            "$ref": "#/backend/entities/Message"
          },
          "description": "Stores all contact form submissions and other messages.",
          "params": [
            {
              "name": "messageId",
              "description": "The unique identifier for the message."
            }
          ]
        }
      },
      {
        "path": "/site_settings/config",
        "definition": {
          "entityName": "SiteSettings",
          "schema": {
            "$ref": "#/backend/entities/SiteSettings"
          },
          "description": "Stores global configuration for site features.",
          "params": []
        }
      }
    ],
    "reasoning": "This Firestore data structure is designed to support the AMpire Studio Dynamic Showcase application, focusing on user authentication, admin profiles, and future content management needs. It prioritizes security, scalability, and debuggability following the core design principles. Path-based ownership is used for user data, and a dedicated collection is used for admin profiles. The structure is designed to enable simple and robust security rules and facilitate listing operations (QAPs). This design avoids hierarchical authorization dependencies."
  }
}
    
    

    

    